#!/usr/bin/env python3
"""codespot — local multi-engine static scan for AI-generated code.

Subcommands: setup | scope | scan | report | selftest
"""

import argparse
import concurrent.futures
import datetime
import time as _time
import time
import json
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.join(HERE, "engines"))

import setup_engine  # noqa: E402

CODESPOT_DIR = ".codespot"
REPORT_JSON = "report.json"
REPORT_MD = "report.md"
ENGINE_TIMEOUT = 900  # semgrep full-repo with full rules can exceed 300s
ENGINE_TIMEOUT_OVERRIDES = {"semgrep": 900, "pmd": 600, "osv-scanner": 600}
SEV_ORDER = {"critical": 0, "major": 1, "minor": 2, "info": 3}


def repo_root(args):
    return os.path.abspath(args.workdir)


def ensure_scope_list(root, scope, out_path):
    import scope as scope_mod
    files, effective = scope_mod.compute(root, scope)
    entries = [{"path": p, "language": scope_mod.detect_language(p)} for p in sorted(set(files))]
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump({"scope": effective, "files": entries}, f, ensure_ascii=False)
    return effective, entries


def select_engines(entries, requested=None, effective_scope=None):
    """Pick adapters per registry: language engines if they match a target file, always_on always.
    Categories disabled via .codespot/config.json rules.<cat>.disabled are skipped.
    Opt-in engines (registry opt_in: true) run only when explicitly requested via
    --engine or enabled via .codespot/config.json rules.<category>.enabled.
    The AI engine is auto-skipped on full scans (scope 'all') unless explicitly
    requested (--engine ai) or permanently enabled (rules.ai_review.enabled)."""
    from common import load_project_config
    registry = setup_engine.load_registry()
    conf_rules = load_project_config().get("rules") or {}
    disabled = {cat for cat, c in conf_rules.items() if isinstance(c, dict) and c.get("disabled")}
    enabled_cats = {cat for cat, c in conf_rules.items() if isinstance(c, dict) and c.get("enabled")}
    requested = set(requested or [])
    ai_skipped_full = False
    unsupported = []
    langs = {e.get("language") for e in entries if e.get("language")}
    chosen = []
    for key, spec in registry.items():
        if spec.get("internal"):
            continue
        if not setup_engine.platform_supported(spec):
            unsupported.append(key)
            continue
        cat = spec.get("category")
        if cat in disabled:
            continue
        if spec.get("agent_driven"):
            if effective_scope == "all" and key not in requested and cat not in enabled_cats:
                ai_skipped_full = True
                continue
        if spec.get("opt_in"):
            if key not in requested and cat not in enabled_cats:
                continue
        elif spec.get("always_on") or (spec.get("languages") != ["*"] and langs.intersection(spec.get("languages", []))):
            pass
        else:
            continue
        chosen.append((key, spec))
    return chosen, ai_skipped_full, unsupported


def run_adapter(key, spec, root, list_path, out_path):
    exe = None if spec.get("agent_driven") else setup_engine.engine_binary(key, spec["version"])
    if exe is None and not spec.get("agent_driven"):
        return key, None, "engine not installed (run: codespot setup)"
    script = os.path.join(HERE, "engines", spec["adapter"])
    env = dict(os.environ, CODESPOT_WORKDIR=root)
    try:
        r = subprocess.run(
            [sys.executable, script, "--workdir", root, "--files", list_path, "--out", out_path],
            capture_output=True, text=True,
            timeout=ENGINE_TIMEOUT_OVERRIDES.get(key, ENGINE_TIMEOUT), env=env)
    except subprocess.TimeoutExpired:
        return key, None, "timed out after %ss" % ENGINE_TIMEOUT
    if r.returncode != 0:
        return key, None, (r.stderr.strip() or "exit code %s" % r.returncode)[:400]
    try:
        with open(out_path, "r", encoding="utf-8") as f:
            return key, json.load(f), None
    except (OSError, ValueError) as e:
        return key, None, "unreadable result: %s" % e


def merge_issues(per_engine):
    """Flatten, drop project ignores + category rule-ignores, dedupe csIds, sort."""
    from common import read_project_ignores, rule_ignore_list
    all_issues = []
    for key, issues in per_engine:
        ignores = read_project_ignores(key)
        rule_ignores = set(rule_ignore_list(key))
        for issue in issues:
            if any(issue.get("file") == ig.get("file") and issue.get("rule") == ig.get("rule")
                   for ig in ignores):
                continue
            if issue.get("rule") in rule_ignores:
                continue
            all_issues.append(issue)
    # csId identifies a RULE (tool|rule), so repeated occurrences share one id.
    # Suffix only when two DIFFERENT tool|rule pairs hash-collide (rare).
    seen = {}
    for issue in all_issues:
        cid = issue["csId"]
        sig = (issue["tool"], issue["rule"])
        if cid in seen and seen[cid] != sig:
            seen[cid + "#n"] = seen.get(cid + "#n", 1) + 1
            issue["csId"] = "%s-%d" % (cid, seen[cid + "#n"])
        else:
            seen[cid] = sig
    all_issues.sort(key=lambda i: (SEV_ORDER.get(i.get("severity"), 9), i.get("file", ""), i.get("line", 0)))
    return all_issues


def render_md(payload):
    """Human-facing report: codespot branding only — no underlying engine names."""
    from common import category_of
    lines = []
    s = payload["summary"]
    if s["total"] == 0:
        lines.append("**✅ 通过**：未发现任何问题（scope=%s，共 %d 个文件）。"
                     % (payload["scope"], len(payload["scope_files"])))
        return "\n".join(lines)
    lines.append("# codespot 扫描报告")
    lines.append("")
    lines.append("- 时间：%s" % payload["generatedAt"])
    lines.append("- 范围：%s（%d 个文件）" % (payload["scope"], len(payload["scope_files"])))
    lines.append("- 发现：%d critical / %d major / %d minor / %d info"
                 % (s["critical"], s["major"], s["minor"], s["info"]))
    for sev, title in (("critical", "🔴 严重"), ("major", "🟠 重要"),
                       ("minor", "🟡 次要"), ("info", "ℹ️ 提示")):
        group = [i for i in payload["issues"] if i["severity"] == sev]
        if not group:
            continue
        lines.append("")
        lines.append("## %s（%d）" % (title, len(group)))
        for i in group:
            lines.append("")
            lines.append("- [%s] `%s:%d` — %s" % (i["csId"], i["file"], i["line"], i["message"]))
            if i.get("snippet"):
                lines.append("  - ```%s```" % i["snippet"].replace("\n", " ")[:160])
    if payload["engine_errors"]:
        lines.append("")
        lines.append("## ⚠️ 检查模块提示")
        # sanitize engine names out of human-facing reasons
        names = {k: (v.get("category") or k) for k, v in setup_engine.load_registry().items()}
        for e in payload["engine_errors"]:
            reason = e["reason"]
            for name, cat in sorted(names.items(), key=lambda kv: -len(kv[0])):
                reason = reason.replace(name, cat)
            lines.append("- 检查模块（%s）本次不可用，已跳过：%s" % (category_of(e["engine"]), reason))
    return "\n".join(lines)


def do_scan(args):
    root = repo_root(args)
    requested_engines = args.engines or []
    if not os.path.isdir(os.path.join(root, ".git")):
        sys.stderr.write("codespot: %s is not a git repository\n" % root)
        return 2
    dot = os.path.join(root, CODESPOT_DIR)
    os.makedirs(dot, exist_ok=True)
    list_path = os.path.join(dot, "scope-files.json")

    effective, entries = ensure_scope_list(root, args.scope, list_path)
    print("scan: scope=%s, %d file(s)" % (effective, len(entries)))
    if not entries:
        payload = {"generatedAt": _now(), "scope": effective, "scope_files": [],
                   "issues": [], "engine_errors": [],
                   "summary": {"critical": 0, "major": 0, "minor": 0, "info": 0, "total": 0}}
        _write_reports(root, payload)
        print("scan: nothing to scan, report written")
        return 0

    chosen, ai_skipped_full, unsupported = select_engines(entries, requested_engines, effective)
    for key in unsupported:
        print("scan: engine '%s' is not available on this platform (see registry platforms)" % key)
    if ai_skipped_full:
        print("scan: full-scope — AI review skipped (add --engine ai, or set rules.ai_review.enabled, to enable)")
    if not chosen:
        sys.stderr.write("codespot: no engine matches the target files\n")
        return 2
    for key, spec in chosen:
        if spec.get("internal"):
            continue
        if not spec.get("agent_driven") and not setup_engine.engine_binary(key, spec["version"]):
            print("scan: %s not installed, running setup first..." % key)
            try:
                setup_engine.setup_engine(spec)
            except RuntimeError as e:
                print("scan: setup failed for %s: %s" % (key, e))

    print("scan: running %d engine(s): %s" % (len(chosen), ", ".join(k for k, _ in chosen)))
    t0 = _time.monotonic()
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(chosen))) as pool:
        futures = {pool.submit(run_adapter, key, spec, root, list_path,
                               os.path.join(dot, "result-%s.json" % key)): key
                   for key, spec in chosen}
        results, done_n = [], 0
        for fut in concurrent.futures.as_completed(futures):
            key = futures[fut]
            done_n += 1
            res = fut.result()
            results.append(res)
            took = _time.monotonic() - t0
            _, issues_n, err = res
            status = ("failed: %s" % err[:80]) if err else ("%d issue(s)" % len(issues_n or []))
            print("scan: [%d/%d] %s — %s (%.1fs)" % (done_n, len(chosen), key, status, took))

    per_engine, engine_errors = [], []
    for key, issues, err in results:
        if err:
            engine_errors.append({"engine": key, "reason": err})
            print("scan: engine %s failed: %s" % (key, err), file=sys.stderr)
        elif issues is not None:
            per_engine.append((key, issues))

    issues = merge_issues(per_engine)
    summary = {k: sum(1 for i in issues if i["severity"] == k)
               for k in SEV_ORDER}
    summary["total"] = len(issues)
    payload = {"generatedAt": _now(), "scope": effective,
               "scope_files": [e["path"] for e in entries],
               "issues": issues, "engine_errors": engine_errors, "summary": summary}
    _write_reports(root, payload)
    ok_engines = [k for k, _, e in results if not e]
    print("scan: done — %d issue(s) from %d engine(s) in %.1fs%s"
          % (len(issues), len(ok_engines), _time.monotonic() - t0,
             ", %d engine error(s)" % len(engine_errors) if engine_errors else ""))
    return 0


def _now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def render_html(payload):
    """codespot-branded self-contained HTML report (validation-report styling)."""
    import html as _h
    s = payload["summary"]

    def esc(x):
        return _h.escape(str(x), quote=False)

    sev_meta = (("critical", "严重", "red"), ("major", "重要", "orange"),
                ("minor", "次要", "yellow"), ("info", "提示", "gray"))
    cards = "".join(
        '<div class="card"><div class="v %s">%d</div><div class="l">%s</div></div>'
        % (cls, s.get(k, 0), label)
        for k, label, cls in (("critical", "严重", "red"), ("major", "重要", "orange"),
                              ("minor", "次要", "yellow"), ("info", "提示", "gray")))
    body = ""
    if s["total"] == 0:
        body = ('<div class="ok">✅ 通过：未发现任何问题（scope=%s，共 %d 个文件）。'
                '</div>' % (esc(payload["scope"]), len(payload["scope_files"])))
    else:
        for k, label, cls in sev_meta:
            group = [i for i in payload["issues"] if i["severity"] == k]
            if not group:
                continue
            items = "".join(
                '<li><span class="cs">%s</span> <code>%s:%d</code> — %s'
                '%s</li>' % (esc(i["csId"]), esc(i["file"]), i["line"],
                             esc(i["message"]),
                             ('<div class="snip">%s</div>' % esc(i["snippet"]))
                             if i.get("snippet") else "")
                for i in group)
            emoji = {"critical": "🔴", "major": "🟠", "minor": "🟡", "info": "ℹ️"}.get(k, "")
            body += '<h3><span class="dot %s"></span>%s %s（%d）</h3><ul>%s</ul>' % (
                cls, emoji, label, len(group), items)
    if payload["engine_errors"]:
        body += '<h3>⚠️ 检查模块提示</h3><ul class="warn">%s</ul>' % "".join(
            '<li>%s</li>' % esc(e["reason"][:200]) for e in payload["engine_errors"])
    tpl = """<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>codespot 扫描报告</title><style>
body{margin:0;font-family:-apple-system,'PingFang SC','Segoe UI',sans-serif;
     background:linear-gradient(180deg,#0d3b66,#f6f8fa 220px);color:#1f2328}
.wrap{max-width:960px;margin:0 auto;padding:40px 24px 60px}
.hero{color:#fff;margin-bottom:26px}
.hero h1{font-size:26px;margin:0}
.hero .meta{color:rgba(255,255,255,.85);font-size:13px;margin-top:6px}
.hero .meta code{background:rgba(255,255,255,.15);color:#fff}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}
.card{background:#fff;border:1px solid #d1d9e0;border-radius:12px;padding:14px;text-align:center;box-shadow:0 1px 4px rgba(13,59,102,.08)}
.card .v{font-size:26px;font-weight:800}
.card .l{font-size:11.5px;color:#59636e;margin-top:2px}
.v.red{color:#cf222e}.v.orange{color:#bc4c00}.v.yellow{color:#9a6700}.v.gray{color:#57606a}
h3{font-size:15px;margin:26px 0 10px;display:flex;align-items:center;gap:8px}
.dot{width:10px;height:10px;border-radius:50%;display:inline-block}
.dot.red{background:#cf222e}.dot.orange{background:#bc4c00}
.dot.yellow{background:#9a6700}.dot.gray{background:#57606a}
ul{list-style:none;padding:0;margin:0}
li{background:#fff;border:1px solid #e4e9ee;border-left:4px solid #d1d9e0;border-radius:8px;
   padding:10px 14px;margin:8px 0;font-size:13.5px}
li:hover{border-left-color:#0969da}
.cs{background:#eff2f5;border-radius:5px;padding:1px 7px;font-weight:700;font-size:12px;margin-right:4px}
code{background:#eff2f5;padding:1px 6px;border-radius:4px;font-size:12.5px}
.snip{color:#59636e;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;
      margin-top:5px;white-space:pre-wrap;word-break:break-all}
.ok{background:#e6f4ea;color:#1a7f37;border-radius:10px;padding:16px;font-weight:600}
.warn li{border-left-color:#d4a72c;background:#fffdf5;font-size:12.5px}
.meta{color:#59636e;font-size:12px;margin-top:40px;text-align:center}
</style></head><body><div class="wrap">
<div class="hero"><h1>codespot 扫描报告</h1>
<div class="meta">时间 {esc(payload["generatedAt"])} · 范围 {esc(payload["scope"])}（{len(payload["scope_files"])} 个文件）· 由 codespot 本地生成</div></div>
<div class="cards">{cards}</div>
{body}
<p class="meta">发现仅为扫描结果，处置由使用者决定 · 本报告由 codespot 自动生成（人读版 report.md / Agent 版 report.json 同目录）</p>
</div></body></html>"""
    return (tpl
        .replace("{__T0__}", str(esc(payload["generatedAt"])))
        .replace("{__T1__}", str(esc(payload["scope"])))
        .replace("{__T2__}", str(len(payload["scope_files"])))
        .replace("{__T3__}", str(cards))
        .replace("{__T4__}", str(body))
    )



def _write_reports(root, payload):
    dot = os.path.join(root, CODESPOT_DIR)
    with open(os.path.join(dot, REPORT_JSON), "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=1)
    with open(os.path.join(dot, REPORT_MD), "w", encoding="utf-8") as f:
        f.write(render_md(payload) + "\n")
    with open(os.path.join(dot, "report.html"), "w", encoding="utf-8") as f:
        f.write(render_html(payload))


def semgrep_rules_dir():
    """Rules live inside the skill so they travel with it (gitignored, downloaded
    by setup / update-rules; shipped pre-seeded in offline bundles)."""
    env_dir = os.environ.get("CODESPOT_SEMGREP_RULES")
    if env_dir:
        return env_dir
    return os.path.join(os.path.dirname(HERE), "rules", "semgrep")


def ensure_semgrep_rules():
    """Ensure <skill>/rules/semgrep exists (shallow clone of OSS rules)."""
    rules = semgrep_rules_dir()
    git = shutil.which("git")
    if not git:
        sys.stderr.write("codespot: git not found — semgrep rules not installed\n")
        return False
    if os.path.isdir(rules):
        return True  # exists; refresh is update-rules' job
    print("setup: cloning semgrep rules (offline defaults)...")
    r = subprocess.run([git, "clone", "--depth", "1", "-q",
                        "https://github.com/semgrep/semgrep-rules", rules],
                       capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        sys.stderr.write("codespot: semgrep rules clone failed — semgrep will use "
                         "--config auto (online) as fallback\n")
        return False
    return True


def do_setup(args):
    if args.offline_dir:
        os.environ["CODESPOT_OFFLINE_DIR"] = os.path.abspath(args.offline_dir)
    try:
        results = setup_engine.setup_all(only=args.engines or None)
    except RuntimeError as e:
        sys.stderr.write("codespot setup: %s\n" % e)
        return 2
    if results and "semgrep" in results:
        ensure_semgrep_rules()
    return 0


def do_scope(args):
    import scope as scope_mod
    root = repo_root(args)
    try:
        files, effective = scope_mod.compute(root, args.scope)
    except RuntimeError as e:
        sys.stderr.write("codespot scope: %s\n" % e)
        return 2
    entries = [{"path": p, "language": scope_mod.detect_language(p)} for p in sorted(set(files))]
    print(json.dumps({"scope": effective, "files": entries}, ensure_ascii=False, indent=1))
    return 0


def do_report(args):
    root = repo_root(args)
    name = "report.html" if getattr(args, "html", False) else REPORT_JSON
    path = os.path.join(root, CODESPOT_DIR, name)
    if not os.path.isfile(path):
        sys.stderr.write("codespot report: no report found (run codespot scan first)\n")
        return 2
    with open(path, "r", encoding="utf-8") as f:
        print(f.read())
    return 0


def do_show(args):
    """User-facing issue details, codespot-branded (CS ids only, no engine names)."""
    root = repo_root(args)
    path = os.path.join(root, CODESPOT_DIR, REPORT_JSON)
    if not os.path.isfile(path):
        sys.stderr.write("codespot show: no report found (run codespot scan first)\n")
        return 2
    with open(path, "r", encoding="utf-8") as f:
        payload = json.load(f)
    sev_filter = {s.strip() for s in (args.severity or "").split(",") if s.strip()}
    issues = payload.get("issues", [])
    if sev_filter:
        issues = [i for i in issues if i.get("severity") in sev_filter]
    if args.file:
        issues = [i for i in issues if i.get("file", "").startswith(args.file)]
    if args.rule:
        issues = [i for i in issues if i.get("csId", "") == args.rule]
    if not issues:
        print("没有匹配的问题（检查过滤条件，或重新 codespot scan）")
        return 0
    limit = len(issues) if args.all else args.limit
    shown = issues[:limit]
    print("共 %d 条匹配%s\n" % (len(issues), "" if args.all else "，显示前 %d 条" % limit))
    for i in shown:
        icon = {"critical": "🔴", "major": "🟠", "minor": "🟡", "info": "ℹ️"}.get(i["severity"], "•")
        print("[%s] %s %s:%d" % (i["csId"], icon, i["file"], i["line"]))
        print("      %s" % i["message"])
        if i.get("snippet"):
            print("      > %s" % i["snippet"].replace("\n", " ")[:160])
    if len(issues) > len(shown):
        print("\n… 其余 %d 条未显示（用 --all 或收窄过滤条件）" % (len(issues) - len(shown)))
    return 0


def prune_semgrep_rules(rules):
    """Keep only rule yamls — the OSS repo ships test fixtures with fake keys
    that trip GitHub secret-scanning push protection."""
    n = 0
    for root, dirs, files in os.walk(rules):
        rel = os.path.relpath(root, rules).replace(os.sep, "/")
        if rel == "generic/secrets":
            shutil.rmtree(root, ignore_errors=True)
            continue
        for f in files:
            if not f.endswith((".yaml", ".yml")):
                os.remove(os.path.join(root, f))
                n += 1
    for root, dirs, files in os.walk(rules, topdown=False):
        if root != rules and not os.listdir(root):
            os.rmdir(root)
    return n


def do_update_rules(args):
    """Refresh <skill>/rules/semgrep (git pull, fallback re-clone)."""
    rules = semgrep_rules_dir()
    git = shutil.which("git")
    if not git:
        sys.stderr.write("codespot update-rules: git not found\n")
        return 2
    if os.path.isdir(os.path.join(rules, ".git")):
        r = subprocess.run([git, "-C", rules, "pull", "--ff-only"],
                           capture_output=True, text=True, timeout=600)
    else:
        shutil.rmtree(rules, ignore_errors=True)
        r = subprocess.run([git, "clone", "--depth", "1", "-q",
                            "https://github.com/semgrep/semgrep-rules", rules],
                           capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        sys.stderr.write("codespot update-rules failed: %s\n" % (r.stderr or r.stdout).strip()[:300])
        return 2
    prune_semgrep_rules(rules)
    print("update-rules: semgrep rules refreshed (%s)" % rules)
    return 0


def do_update_rules(args):
    """Refresh <skill>/rules/semgrep (git pull, fallback re-clone)."""
    rules = semgrep_rules_dir()
    git = shutil.which("git")
    if not git:
        sys.stderr.write("codespot update-rules: git not found\n")
        return 2
    if os.path.isdir(os.path.join(rules, ".git")):
        r = subprocess.run([git, "-C", rules, "pull", "--ff-only"],
                           capture_output=True, text=True, timeout=600)
    else:
        shutil.rmtree(rules, ignore_errors=True)
        r = subprocess.run([git, "clone", "--depth", "1", "-q",
                            "https://github.com/semgrep/semgrep-rules", rules],
                           capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        sys.stderr.write("codespot update-rules failed: %s\n" % (r.stderr or r.stdout).strip()[:300])
        return 2
    prune_semgrep_rules(rules)
    print("update-rules: semgrep rules refreshed (%s)" % rules)
    return 0


def do_update_db(args):
    """Download/refresh the local OSV vulnerability DB for offline dependency scans."""
    spec = setup_engine.load_registry().get("osv-scanner")
    if not spec:
        sys.stderr.write("codespot update-db: osv-scanner not in registry\n")
        return 2
    exe = setup_engine.engine_binary("osv-scanner", spec["version"])
    if not exe:
        sys.stderr.write("codespot update-db: osv-scanner not installed (run codespot setup)\n")
        return 2
    import tempfile
    # one seed lockfile per ecosystem — the offline DB is downloaded per-ecosystem.
    # NOTE: every seed MUST contain at least one real package entry — empty or
    # comment-only shells yield "No package sources found" and nothing downloads.
    seeds = {
        "PyPI": ("requirements.txt", "text"),
        "npm": ("package-lock.json", "npm"),
        "Go": ("go.mod", "gomod"),
        "Maven": ("pom.xml", "maven"),
        "RubyGems": ("Gemfile.lock", "rubygems"),
        "NuGet": ("dummy.csproj", "csproj"),
        "Packagist": ("composer.lock", "packagist"),
    }
    ok, failed = [], []
    for eco, (fname, kind) in seeds.items():
        with tempfile.TemporaryDirectory(prefix="codespot-db-") as tmpd:
            seed = os.path.join(tmpd, fname)
            if kind == "maven":
                with open(seed, "w") as f:
                    f.write('<?xml version="1.0"?>\n<project xmlns="http://maven.apache.org/POM/4.0.0">\n'
                            '  <modelVersion>4.0.0</modelVersion>\n  <groupId>seed</groupId>'
                            '<artifactId>seed</artifactId><version>1.0</version>\n  <dependencies>\n'
                            '    <dependency><groupId>junit</groupId><artifactId>junit</artifactId>'
                            '<version>4.13.2</version></dependency>\n  </dependencies>\n</project>\n')
            elif kind == "rubygems":
                with open(seed, "w") as f:
                    f.write('GEM\n  remote: https://rubygems.org/\n  specs:\n'
                            '    rack (3.0.8)\n\nPLATFORMS\n  ruby\n\nDEPENDENCIES\n  rack\n')
            elif kind == "csproj":
                with open(seed, "w") as f:
                    f.write('<Project Sdk="Microsoft.NET.Sdk">\n'
                            '  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>\n'
                            '  <ItemGroup><PackageReference Include="Newtonsoft.Json" Version="13.0.3" />'
                            '</ItemGroup>\n</Project>\n')
            elif kind == "packagist":
                with open(seed, "w") as f:
                    f.write('{"packages":[{"name":"psr/log","version":"3.0.0"}],"packages-dev":[]}\n')
            elif kind == "gomod":
                with open(seed, "w") as f:
                    f.write('module example.com/seed\n\ngo 1.21\n\nrequire github.com/pkg/errors v0.9.1\n')
            if kind == "text":
                # PyPI: a real pinned requirement — comment-only shells don't download
                with open(seed, "w") as f:
                    f.write("requests==2.19.0\n")
            if kind == "npm":
                # needs >=1 real package entry, else "No package sources found"
                with open(seed, "w") as f:
                    f.write('{"name":"seed","version":"1.0.0","lockfileVersion":3,'
                            '"packages":{"node_modules/semver":{"version":"7.6.0"}}}')
            elif kind == "rubygems":
                with open(seed, "w") as f:
                    f.write('GEM\n  remote: https://rubygems.org/\n  specs:\n\nPLATFORMS\n  ruby\n')
            else:
                with open(seed, "w") as f:
                    f.write("# seed lockfile for %s database download\n" % eco)
            cmd = [exe, "scan", "source", "--download-offline-databases",
                   "--offline-vulnerabilities", "--allow-no-lockfiles", "-f", "json", seed]
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=900, cwd=tmpd)
            except subprocess.TimeoutExpired:
                failed.append(eco)
                sys.stderr.write("codespot update-db: %s download timed out\n" % eco)
                continue
            # osv-scanner 2.6 quirk: the DB lands in the cache even when the process
            # later exits 127 (post-download processing error) — verify by presence
            import glob as _glob
            bases = (os.path.expanduser("~/Library/Caches/osv-scalibr"),
                     os.path.expanduser(os.path.join(os.environ.get("XDG_CACHE_HOME", "~/.cache"), "osv-scalibr")))
            landed = any(_glob.glob(os.path.join(b, eco + "*", "*.zip")) for b in bases)
            if landed:
                ok.append(eco)
            elif r.returncode not in (0, 1):
                failed.append(eco)
                sys.stderr.write("codespot update-db: %s failed (exit %s): %s\n"
                                 % (eco, r.returncode, r.stderr.strip()[-300:]))
            else:
                failed.append(eco)
                sys.stderr.write("codespot update-db: %s db not downloaded: %s\n"
                                 % (eco, r.stderr.strip()[-300:]))
    print("update-db: OSV offline databases refreshed for: %s%s"
          % (", ".join(ok) or "(none)", ", failed: " + ", ".join(failed) if failed else ""))
    return 0 if not failed else 2


def do_ai_scan(args):
    """absorb: validate agent-written .codespot/ai-result.json and merge into the last report."""
    root = repo_root(args)
    result_path = os.path.join(root, CODESPOT_DIR, "ai-result.json")
    report_path = os.path.join(root, CODESPOT_DIR, REPORT_JSON)
    if not os.path.isfile(result_path):
        sys.stderr.write("codespot ai-scan: %s not found (agent must analyze per ai-plan.json first)\n" % result_path)
        return 2
    if not os.path.isfile(report_path):
        sys.stderr.write("codespot ai-scan: no prior report — run codespot scan --engine ai first\n")
        return 2
    try:
        with open(result_path, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except ValueError as e:
        sys.stderr.write("codespot ai-scan: ai-result.json is not valid JSON: %s\n" % e)
        return 2
    if not isinstance(raw, list):
        sys.stderr.write("codespot ai-scan: ai-result.json must be a JSON array\n")
        return 2

    from common import make_issue, SEVERITIES
    accepted, rejected = [], []
    for idx, item in enumerate(raw):
        why = None
        if not isinstance(item, dict):
            why = "not an object"
        else:
            rule = str(item.get("rule", "")).strip()
            if not rule:
                why = "missing rule"
            sev = str(item.get("severity", "major")).lower()
            if sev not in SEVERITIES:
                why = "bad severity '%s'" % item.get("severity")
            fp = item.get("file", "")
            abs_fp = fp if os.path.isabs(fp) else os.path.join(root, fp)
            if not fp or not os.path.isfile(abs_fp):
                why = "file not found: %s" % fp
            else:
                try:
                    with open(abs_fp, "r", encoding="utf-8", errors="replace") as f:
                        nlines = sum(1 for _ in f)
                except OSError:
                    nlines = 0
                line = item.get("line", 0)
                if not isinstance(line, int) or line < 1 or line > max(nlines, 1):
                    why = "line %s out of range (file has %d lines)" % (line, nlines)
            if not why and not str(item.get("message", "")).strip():
                why = "missing message"
        if why:
            rejected.append((idx, why))
            sys.stderr.write("codespot ai-scan: rejected item #%d — %s\n" % (idx, why))
            continue
        if not rule.startswith("AI-"):
            rule = "AI-" + rule
        issue = make_issue(tool="ai", language="*", rule=rule, rule_url="",
                           severity=str(item.get("severity", "major")).lower(),
                           file=str(item.get("file", "")), line=int(item.get("line", 1)),
                           column=int(item.get("column", 1) or 1),
                           message=str(item.get("message", "")),
                           snippet=str(item.get("snippet", ""))[:160])
        conf = str(item.get("confidence", "")).lower()
        if conf in ("high", "medium", "low"):
            issue["confidence"] = conf
        accepted.append(issue)

    with open(report_path, "r", encoding="utf-8") as f:
        payload = json.load(f)
    payload["issues"] = [i for i in payload.get("issues", []) if i.get("tool") != "ai"] + accepted
    payload["issues"].sort(key=lambda i: (SEV_ORDER.get(i.get("severity"), 9), i.get("file", ""), i.get("line", 0)))
    payload["summary"] = {k: sum(1 for i in payload["issues"] if i["severity"] == k)
                          for k in SEV_ORDER}
    payload["summary"]["total"] = len(payload["issues"])
    _write_reports(root, payload)
    print("ai-scan: absorbed %d finding(s)%s — reports updated"
          % (len(accepted), ", %d rejected" % len(rejected) if rejected else ""))
    if not accepted and rejected:
        return 2
    return 0


def do_selftest(args):
    # fixtures live at repo level (dev asset, not part of the installed skill):
    # <repo>/tests/fixtures next to skill/, or skill/tests/fixtures as fallback
    candidates = [
        os.path.join(os.path.dirname(HERE), "tests", "fixtures"),  # repo layout
        os.path.join(HERE, "tests", "fixtures"),                   # legacy skill layout
        os.path.join(os.path.dirname(os.path.dirname(HERE)), "tests", "fixtures"),
    ]
    fixtures = next((c for c in candidates if os.path.isdir(c)), None)
    if not fixtures:
        sys.stderr.write("codespot selftest: fixtures not found (repo tests/ or skill/tests/)\n")
        return 2
    expected_path = os.path.join(fixtures, "expected.json")
    with open(expected_path, "r", encoding="utf-8") as f:
        expected = json.load(f)

    tmp = tempfile.mkdtemp(prefix="codespot-selftest-")
    list_path = os.path.join(tmp, "files.json")
    files = [{"path": os.path.join(fixtures, rel), "language": None} for rel in expected["files"]]
    with open(list_path, "w") as f:
        json.dump({"scope": "selftest", "files": files}, f)

    registry = setup_engine.load_registry()
    failures = 0
    os.environ["CODESPOT_WORKDIR"] = HERE  # load repo-level severity mapping
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = {}
        for key, spec in registry.items():
            if spec.get("internal"):
                continue
            if not setup_engine.platform_supported(spec):
                print("selftest: SKIP %s (not supported on this platform)" % key)
                continue
            if not setup_engine.engine_binary(key, spec["version"]):
                print("selftest: SKIP %s (not installed)" % key)
                continue
            out = os.path.join(tmp, "result-%s.json" % key)
            futures[pool.submit(run_adapter, key, spec, fixtures, list_path, out)] = key
        for fut, key in futures.items():
            _, issues, err = fut.result()
            if err:
                if registry[key].get("selftest_optional"):
                    print("selftest: SKIP %s (network engine unavailable: %s)" % (key, err[:80]))
                else:
                    print("selftest: FAIL %s — %s" % (key, err))
                    failures += 1
                continue
            problems = _check_expectations(key, issues, expected, fixtures)
            if problems:
                failures += 1
                for p in problems:
                    print("selftest: FAIL %s — %s" % (key, p))
            else:
                print("selftest: PASS %s (%d issues)" % (key, len(issues)))
    shutil.rmtree(tmp, ignore_errors=True)
    if failures:
        print("selftest: %d failure(s)" % failures)
        return 2
    print("selftest: all engines passed")
    return 0


def _check_expectations(key, issues, expected, fixtures):
    from common import REQUIRED_FIELDS
    problems = []
    exp = expected.get("expectations", {}).get(key, {})
    for i in issues:
        missing = [k for k in REQUIRED_FIELDS if k not in i]
        if missing:
            problems.append("issue missing fields %s" % missing)
            break
        if not (isinstance(i.get("csId"), str) and i["csId"].startswith("CS-")):
            problems.append("issue missing valid csId")
            break
        if i["severity"] not in SEV_ORDER:
            problems.append("bad severity %s" % i["severity"])
            break
        if i["file"].startswith("/"):
            i["file"] = os.path.relpath(i["file"], fixtures).replace(os.sep, "/")
    want_rules = set(exp.get("rules", []))
    got_rules = {i["rule"] for i in issues}
    missing_rules = want_rules - got_rules
    if missing_rules:
        problems.append("expected rules not reported: %s (got %s)" % (sorted(missing_rules), sorted(got_rules)))
    min_count = exp.get("min_count")
    if min_count is not None and len(issues) < min_count:
        problems.append("expected >=%s issues, got %s" % (min_count, len(issues)))
    for bad in exp.get("forbidden_snippets", []):
        if any(bad in json.dumps(i) for i in issues):
            problems.append("forbidden raw snippet leaked: %s" % bad)
    # branding: rendered md must not leak engine names
    md = open(os.path.join(fixtures, ".codespot", "report.md")).read() \
        if os.path.isfile(os.path.join(fixtures, ".codespot", "report.md")) else None
    if md is not None:
        for name in ("ruff", "bandit", "oxlint", "sonarjs", "PMD", "SpotBugs",
                     "gitleaks", "sqlfluff", "semgrep", "eslint"):
            if name in md:
                problems.append("engine name '%s' leaked into report.md" % name)
                break
    return problems


def main():
    p = argparse.ArgumentParser(prog="codespot", description="local multi-engine static scan")
    p.add_argument("--workdir", default=".", help="target repository root (default: cwd)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("setup", help="install scan engines (idempotent)")
    sp.add_argument("--offline-dir", help="offline bundle dir: install venv engines from wheels/ with --no-index")
    sp.add_argument("engines", nargs="*", help="specific engines (default: all)")
    sp.set_defaults(fn=do_setup)

    sp = sub.add_parser("scope", help="compute scan file list")
    sp.add_argument("--scope", default="auto",
                    help="uncommitted | unpushed | ref:<ref> | all | auto (default)")
    sp.set_defaults(fn=do_scope)

    sp = sub.add_parser("scan", help="run all matching engines and write reports")
    sp.add_argument("--scope", default="auto")
    sp.add_argument("--engine", action="append", dest="engines",
                    help="explicitly run an opt-in engine (e.g. trufflehog); repeatable")
    sp.set_defaults(fn=do_scan)

    sp = sub.add_parser("report", help="print last report.json")
    sp.add_argument("--html", action="store_true", help="print report.html instead")
    sp.set_defaults(fn=do_report)

    sp = sub.add_parser("show", help="browse issue details from the last report")
    sp.add_argument("--severity", help="filter: critical,major,minor,info (comma-separated)")
    sp.add_argument("--file", help="filter by file path prefix")
    sp.add_argument("--rule", help="filter by CS rule id")
    sp.add_argument("--limit", type=int, default=50)
    sp.add_argument("--all", action="store_true", help="show all matches")
    sp.set_defaults(fn=do_show)

    sp = sub.add_parser("update-rules", help="refresh local semgrep rules (offline defaults)")
    sp.set_defaults(fn=do_update_rules)

    sp = sub.add_parser("ai-scan", help="absorb agent-written AI review results into the last report")
    sp.add_argument("mode", nargs="?", default="absorb", choices=["absorb"])
    sp.set_defaults(fn=do_ai_scan)

    sp = sub.add_parser("selftest", help="run fixture-based regression across engines")
    sp.set_defaults(fn=do_selftest)

    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
